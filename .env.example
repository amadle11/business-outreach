# --- Required ---
# Password you type to log in to the dashboard
ADMIN_PASSWORD=change-me
# Public URL of the app (used in emails, QR codes and preview links).
# On Netlify you can leave this out; Netlify's own URL is used automatically.
APP_URL=http://localhost:3000
# Random string. The GitHub Actions schedule sends it to the cron routes as "Bearer <CRON_SECRET>"
CRON_SECRET=some-long-random-string

# Database: leave as file:local.db locally. In production use Turso (libsql://...)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# --- Lead finding ---
# Google Cloud API key with "Places API (New)" enabled
GOOGLE_PLACES_API_KEY=

# --- Email (your Gmail, using an App Password) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Postcards ---
# Lob API key. test_... keys never mail anything (safe); live_... keys mail real cards.
LOB_API_KEY=
